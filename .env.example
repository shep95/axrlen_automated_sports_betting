# OpenAI (required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Trading mode — paper by default
PAPER_TRADING=true
LIVE_TRADING=false
# Required when LIVE_TRADING=true
AXRLEN_CONFIRM_LIVE_RISK=false

# Polymarket wallet (live trading only)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=3

# Optional pre-derived CLOB credentials
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Bot behavior
BET_SIZE_USD=5
MIN_CONFIDENCE=0.65
MAX_MARKETS_PER_CYCLE=3
SCAN_INTERVAL_MINUTES=7
RESOLUTION_WINDOW_HOURS=24
MARKET_CATEGORIES=weather,crypto

# Optional web search enrichment
TAVILY_API_KEY=

# Brains directory (defaults to ./brains)
# BRAINS_DIR=

# Railway sets PORT automatically
HEALTH_PORT=8080
LOG_LEVEL=INFO
