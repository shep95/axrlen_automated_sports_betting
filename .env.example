# =============================================================================
# AXRLEN — environment variables (names match Polymarket / OpenAI APIs)
# Copy to .env locally or set in Railway → Variables
# =============================================================================

# --- OpenAI (Chat Completions — market research AI) ---------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# API model id, e.g. gpt-5.2-chat-latest (Instant) or gpt-5.2 (Thinking)
OPENAI_MODEL=gpt-5.2-chat-latest

# --- Polymarket CLOB — order placement (https://clob.polymarket.com) ----------
# Paper = simulate orders (no CLOB calls). Live = real orders + real USDC.
POLYMARKET_CLOB_PAPER_TRADING=true
POLYMARKET_CLOB_LIVE_TRADING=false
# Must be true when POLYMARKET_CLOB_LIVE_TRADING=true (you accept financial risk)
POLYMARKET_CLOB_CONFIRM_LIVE_RISK=false

# ClobClient `key` — private key of the wallet that SIGNS orders (your MetaMask EOA, etc.)
POLYMARKET_SIGNER_PRIVATE_KEY=
# ClobClient `funder` — Polymarket PROXY wallet that HOLDS your deposited USDC (not your MetaMask address)
POLYMARKET_FUNDER_ADDRESS=
# ClobClient `signature_type`: 0=EOA 1=POLY_PROXY 2=POLY_GNOSIS_SAFE 3=POLY_GNOSIS_SAFE (browser wallet is often 2 or 3)
POLYMARKET_SIGNATURE_TYPE=3

# ClobClient ApiCreds (optional — auto-derived from signer key if left blank)
# https://docs.polymarket.com/trading/overview
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=

# Live CLOB order size in USDC per bet (ignored in paper mode)
POLYMARKET_CLOB_ORDER_SIZE_USD=5

# --- Polymarket Gamma — market discovery (https://gamma-api.polymarket.com, no API key) ---
# Comma-separated categories to scan: weather,crypto,sports,politics
POLYMARKET_GAMMA_MARKET_CATEGORIES=weather,crypto
# Only markets resolving within this many hours
POLYMARKET_GAMMA_RESOLUTION_HOURS=24
# Max markets to research per bot cycle
POLYMARKET_GAMMA_MAX_MARKETS_PER_SCAN=3

# --- Axrlen paper bankroll (simulated USDC — not Polymarket API) ---------------
AXRLEN_PAPER_STARTING_CAPITAL_USD=100
AXRLEN_PAPER_MIN_ORDER_USD=5
AXRLEN_PAPER_MAX_ORDER_USD=50
# Below this free capital, paper orders stay at MIN; above, size compounds up to MAX
AXRLEN_PAPER_COMPOUND_AT_CAPITAL_USD=300
AXRLEN_PAPER_COMPOUND_PERCENT=0.10

# --- Axrlen bot behavior ------------------------------------------------------
AXRLEN_SCAN_INTERVAL_MINUTES=7
AXRLEN_AI_MIN_CONFIDENCE=0.65
AXRLEN_AI_RESEARCH_SIMPLE=true
# AXRLEN_BRAINS_DIR=
# AXRLEN_BRAINS_MAX_CHARS=250000
AXRLEN_AI_MAX_RETRIES=3
AXRLEN_AI_TIMEOUT_SECONDS=60
AXRLEN_LOG_LEVEL=INFO
AXRLEN_HEALTH_PORT=8080

# --- Optional research APIs (not Polymarket) ----------------------------------
# Tavily web search — https://tavily.com
TAVILY_API_KEY=

# --- Railway (auto-set; do not copy) ------------------------------------------
# PORT=

# =============================================================================
# LEGACY NAMES (still work if you already set these in Railway)
# PAPER_TRADING, LIVE_TRADING, POLYMARKET_PRIVATE_KEY, CLOB_API_KEY, BET_SIZE_USD,
# MARKET_CATEGORIES, PAPER_STARTING_CAPITAL, MIN_CONFIDENCE, AI_RESEARCH_SIMPLE, etc.
# =============================================================================
